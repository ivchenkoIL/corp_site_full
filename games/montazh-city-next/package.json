{
  "name": "montazh-city-next",
  "private": true,
  "version": "0.1.0",
  "description": "Монтаж-Сити на Babylon.js: модульная игра, логика отдельно от графики",
  "type": "module",
  "scripts": {
    "split": "node tools/split-legacy.mjs",
    "dev": "vite",
    "build": "vite build",
    "build:legacy": "vite build --config vite.legacy.config.js",
    "assets": "node tools/fetch-assets.mjs",
    "check:legacy": "node tools/legacy-parity.mjs",
    "shots": "node tools/shots.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "^9.28.0",
    "@babylonjs/loaders": "^9.28.0"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.9",
    "@babel/traverse": "^7.29.8",
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "magic-string": "^0.30.21",
    "meshoptimizer": "^1.3.0",
    "sharp": "^0.35.5",
    "vite": "^8.3.1",
    "vite-plugin-singlefile": "^2.3.3"
  }
